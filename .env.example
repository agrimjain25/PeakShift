# Copy this file to ".env" and fill in your values. NEVER commit ".env" to Git.
QUICKML_ENDPOINT_KEY=paste-endpoint-key-here
CATALYST_ORG=paste-catalyst-org-id-here
QUICKML_ENVIRONMENT=Development
ZOHO_CLIENT_ID=paste-client-id-here
ZOHO_CLIENT_SECRET=paste-client-secret-here
ZOHO_REFRESH_TOKEN=paste-refresh-token-here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional: a ready access token (expires in about 1 hour). Not needed if the 3 ZOHO_ values above are set.
# QUICKML_ACCESS_TOKEN=
